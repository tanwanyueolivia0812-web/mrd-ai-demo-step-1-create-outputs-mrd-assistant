{
  "name": "mrd-research-assistant",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "start": "serve -s dist -l tcp://0.0.0.0:3000",
    "typecheck": "tsc --noEmit -p jsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "docx": "^9.8.1",
    "lucide-react": "^0.468.0",
    "markdown-it": "^15.0.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "serve": "^14.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.5.0",
    "typescript": "^5.9.3",
    "vite": "^6.1.0"
  },
  "engines": {
    "node": "22.x"
  }
}
