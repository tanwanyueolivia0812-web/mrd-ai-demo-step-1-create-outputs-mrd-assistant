# Current single-user Demo requires no environment variables or API keys.
# No real AI or cloud upload provider is currently connected.
# Future server-only integration placeholders; uncomment only when implemented.
# Never prefix secrets with VITE_ or include them in browser code.
# AI_API_KEY=                 # Model provider secret; server-side API only
# AI_MODEL=                   # Model identifier chosen by the server implementation
# BLOB_READ_WRITE_TOKEN=      # Vercel Blob token; server-side upload authorization only
